# android/keystore.properties.example
#
# このファイルはサンプルです。コミットしても安全です。
# 実際の keystore.properties は Git 管理しないでください（.gitignore 済み）。
#
# 使い方:
#   1. このファイルを android/keystore.properties にコピーする
#   2. 各値を実際の keystore 情報に書き換える
#   3. android/keystore.properties は絶対にコミットしない

storeFile=app/release.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=toinavi
keyPassword=YOUR_KEY_PASSWORD
